# Copy this file to .env and fill in credentials locally.
OPENAI_API_KEY=
# Responses handles structured extraction and reply drafts.
OPENAI_RESPONSE_MODEL=gpt-6-luna
# The Decisions API currently supports gpt-6-luna.
OPENAI_DECISION_MODEL=gpt-6-luna
# Embeddings use a separate model and the same OPENAI_API_KEY.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Conversation history, customer profiles, result memory, and the status cache.
SUPPORT_DATABASE_PATH=.state/support.sqlite3
# Optional override; blank uses <support database stem>.checkpoints.sqlite3 alongside it.
SUPPORT_CHECKPOINT_PATH=
# LangSmith tracing: fill in the key and set true when you want to record runs.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_AGENT_ID=ticket-triage-agent
LANGSMITH_AGENT_ENVIRONMENT=local
# LANGSMITH_PROJECT=support-ticket-triage-agent
# Optional for API keys linked to multiple workspaces:
# LANGSMITH_WORKSPACE_ID=
